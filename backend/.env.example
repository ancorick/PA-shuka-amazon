# Copy to .env for local development. On Render set these in Environment → Environment Variables.

# Port to listen on. Render sets PORT automatically — do not set it there.
PORT=3000

# development | production  (production → Secure cookies, JWT_SECRET required)
NODE_ENV=development

# Secret used to sign the session cookie. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Folder for shuka.db, uploads/ and backups/ (relative to backend/ or absolute).
DATA_DIR=./data

# Comma-separated origins allowed by CORS (local Vite dev server by default).
CORS_ORIGIN=http://localhost:5173

# Public URL prefix for images as the browser sees them (frontend proxies /api/* → backend).
UPLOADS_PUBLIC_PATH=/api/uploads
